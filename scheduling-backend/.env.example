# Copy to .env and export, or set inline. All optional except Google mode vars.

# memory (default, no creds needed) | google
PROVIDER=memory
PORT=8080

# Google mode — service account must have "Make changes to events" on the calendar
#GOOGLE_CALENDAR_ID=your-room@resource.calendar.google.com
#GOOGLE_SA_KEY_FILE=./service-account.json

# Serve the built panel app from the same process (kiosk URL target)
#STATIC_DIR=../scheduling-panel/dist

# HTTPS — REQUIRED for the TSS panel kiosk URL (panel trusts public CAs out of box)
#TLS_CERT=./cert.pem
#TLS_KEY=./key.pem
